# Copy to config.local.env and fill YOUR values (gitignored).

DEVICE_ID=RPi-GW-EXAMPLE-01
TENANT_ID=tenant-example
ASSET_ID=site-example

MQTT_BROKER=192.168.1.100
MQTT_PORT=1883
MQTT_USER=mqtt_user
MQTT_PASS=mqtt_password
MQTT_TOPIC=devices/telemetry

PUBLISH_INTERVAL_SEC=60

# Optional: enable GPIO if gpiozero installed and pins wired
USE_GPIO=0
GPIO_INPUT_PIN=17
